# Copy to .env (git-ignored), fill in, then: set -a; source .env; set +a
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USER=DBT_SERVICE
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/<you>/.snowflake/dbt_service_key.p8
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_DATABASE=AE_TASK
SNOWFLAKE_WAREHOUSE=DBT_WH
SNOWFLAKE_SCHEMA=DBT_DEV
